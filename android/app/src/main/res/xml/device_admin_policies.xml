<?xml version="1.0" encoding="utf-8"?>
<!-- Only force-lock is requested: the one DevicePolicyManager capability this app actually
     uses (DevicePolicyManager.lockNow(), triggered by a server-pushed lock:update). -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>
