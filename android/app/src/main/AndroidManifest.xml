<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Networking. This app is a *server*: INTERNET is needed to bind and accept, not to dial
         out; nothing outbound is ever contacted. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The embedded listener has to stay answerable while the screen is off, otherwise a parent
         "randomly" can't connect. See acquireWifiLock() in MonitorForegroundService. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Per-app usage tracking. Access is actually granted via the special
         Settings.ACTION_USAGE_ACCESS_SETTINGS screen (AppOps), not a runtime dialog; see
         ui/permissions/PermissionsScreen.kt. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Fallback full-screen block overlay when the accessibility service is unavailable; see
         the design-note comment in enforcement/PolicyForegroundAccessibilityService.kt. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground monitor service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Restart enforcement (and the listener) after a reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- List every installed app (not just ones that declare intents targeting this app) so the
         home screen and `GET /apps` are complete. This is the kind of broad package-visibility
         exemption Play Store reserves for parental-control apps; a store listing would need to
         justify it in the Play Console. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".OpenLinkApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.OpenLink"
        tools:targetApi="34">
        <!-- No android:usesCleartextTraffic. The previous build set it true so the app could talk
             to a self-hosted server over plain HTTP on a LAN. There is no outbound traffic at all
             now, and the listener this app *hosts* is TLS-only, so cleartext has no role here. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.OpenLink">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground service: polls UsageStatsManager, tallies usage into Room, hosts the
             embedded TLS HTTP/WebSocket listener the parent app connects to, and advertises it
             over mDNS. -->
        <service
            android:name=".service.MonitorForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Parental screen-time enforcement, remote lock, and the local listener the parent device connects to" />
        </service>

        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Lets a parent trigger DevicePolicyManager.lockNow() remotely, and lets us notice when
             it is revoked (see admin/ChildDeviceAdminReceiver.kt). -->
        <receiver
            android:name=".admin.ChildDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Detects foreground-app changes and draws the full-screen block overlay. See the
             design-note comment at the top of PolicyForegroundAccessibilityService.kt for why
             this is the chosen enforcement mechanism over a plain Service+WindowManager. -->
        <service
            android:name=".enforcement.PolicyForegroundAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
